{
  "manifest_version": 3,
  "name": "LifeTools",
  "short_name": "LifeTools",
  "version": "0.1.0",
  "description": "Günlük küçük araçlar: site engelleyici ve daha fazlası. Veriler yalnızca bu tarayıcıda.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "webNavigation", "offscreen", "contextMenus", "activeTab", "scripting"],
  "commands": {
    "save-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Seçili metni SlapMemo'ya kaydet"
    }
  },
  "host_permissions": [
    "*://x.com/*",
    "*://www.x.com/*",
    "*://twitter.com/*",
    "*://www.twitter.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LifeTools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
