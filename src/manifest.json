{
  "manifest_version": 3,
  "name": "LifeTools",
  "short_name": "LifeTools",
  "version": "0.5.5",
  "description": "Günlük küçük araçlar: site engelleyici ve daha fazlası. Veriler yalnızca bu tarayıcıda.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabCapture",
    "idle",
    "alarms",
    "storage",
    "clipboardWrite",
    "webNavigation",
    "offscreen",
    "contextMenus",
    "activeTab",
    "scripting",
    "tabGroups",
    "notifications",
    "favicon",
    "downloads",
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Resim içinde resmi aç/kapat"
    },
    "save-selection": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Seçimi veya sayfayı SlapMemo'ya kaydet"
    },
    "open-switcher": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Görsel sekme değiştiriciyi aç"
    },
    "open-command-center": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "Komut merkezini aç"
    },
    "action-link-copy": {
      "description": "Sayfanın temiz linkini kopyala"
    },
    "action-task-page": {
      "description": "Bu sayfayı göreve ekle"
    },
    "action-session-save": {
      "description": "Oturumu kaydet"
    },
    "action-blocker-toggle": {
      "description": "Engelleyiciyi aç/kapat"
    },
    "action-group-site": {
      "description": "Sekmeleri siteye göre grupla"
    }
  },
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://video.twimg.com/*",
    "*://x.com/*",
    "*://www.x.com/*",
    "*://twitter.com/*",
    "*://www.twitter.com/*",
    "*://www.instagram.com/*",
    "*://instagram.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LifeTools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.instagram.com/*", "*://instagram.com/*"],
      "js": ["ig-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.instagram.com/*", "*://instagram.com/*"],
      "js": ["ig-ui.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://www.x.com/*",
        "*://twitter.com/*",
        "*://www.twitter.com/*"
      ],
      "js": [
        "x-video-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://www.x.com/*",
        "*://twitter.com/*",
        "*://www.twitter.com/*"
      ],
      "js": [
        "x-video-ui.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://www.x.com/*",
        "*://twitter.com/*",
        "*://www.twitter.com/*"
      ],
      "js": [
        "site-blocker-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "panel.html"
}
