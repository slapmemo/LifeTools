{
  "manifest_version": 3,
  "name": "X Sekme Koruması",
  "short_name": "X Koruma",
  "version": "1.0.0",
  "description": "Seçtiğin X/Twitter profillerine girildiğinde sekmeyi otomatik kapatır.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": [
    "*://x.com/*",
    "*://www.x.com/*",
    "*://twitter.com/*",
    "*://www.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "X Sekme Koruması",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
